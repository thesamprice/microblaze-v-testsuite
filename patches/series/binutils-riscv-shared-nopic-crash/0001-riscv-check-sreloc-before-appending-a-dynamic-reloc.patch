     run_dump_test "shared-lib-nopic-03"
     run_dump_test "shared-lib-nopic-04"
+    run_dump_test "shared-lib-nopic-05"
+    run_dump_test "shared-lib-nopic-06"
 
     run_dump_test "data-reloc-rv64-pic"
     run_dump_test "data-reloc-rv64-pie"
